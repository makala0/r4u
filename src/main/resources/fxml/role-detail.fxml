<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.ScatterChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cz.be.r4u.ui.RoleDetailController">

    <top>
        <VBox spacing="12.0">
            <padding>
                <Insets top="14.0" right="20.0" bottom="12.0" left="20.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <Label fx:id="titleLabel"
                       text="Detail role"
                       style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
                <Label fx:id="operatorLabel"
                       text="Operátor"
                       style="-fx-font-size: 13px; -fx-text-fill: #666666;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Správa vyřazení" onAction="#onOpenRejectRulesClick"/>
                <Button text="Export CSV" onAction="#onExportCsvClick"/>
                <Button text="Export XLSX" onAction="#onExportXlsxClick"/>
                <Button text="Zpět na dashboard" onAction="#onBackToDashboardClick"/>
            </HBox>

            <Label fx:id="messageLabel"
                   wrapText="true"
                   style="-fx-text-fill: #C62828; -fx-font-weight: bold;"/>

            <GridPane hgap="18.0" vgap="10.0">
                <Label text="createdAt:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <Label fx:id="createdAtLabel" text="-" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="orderNumber:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <Label fx:id="orderNumberLabel" text="-" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <Label text="min:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <Label fx:id="minLabel" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="status:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <Label fx:id="statusLabel" text="-" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                <Label text="počet defektů:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <Label fx:id="defectsCountLabel" text="-" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
            </GridPane>
        </VBox>
    </top>

    <center>
        <VBox spacing="12.0">
            <padding>
                <Insets right="20.0" bottom="20.0" left="20.0"/>
            </padding>

            <Label text="Graf role"
                   style="-fx-font-size: 15px; -fx-font-weight: bold;"/>

            <FlowPane fx:id="legendPane"
                      hgap="14.0"
                      vgap="6.0"
                      prefWrapLength="900.0"/>

            <ScatterChart fx:id="rollChart" prefHeight="420.0" legendVisible="false">
                <xAxis>
                    <NumberAxis fx:id="rollChartXAxis"/>
                </xAxis>
                <yAxis>
                    <CategoryAxis fx:id="rollChartYAxis"/>
                </yAxis>
            </ScatterChart>

            <Label text="Defekty role"
                   style="-fx-font-size: 15px; -fx-font-weight: bold;"/>

            <HBox spacing="12.0" VBox.vgrow="ALWAYS">
                <TableView fx:id="defectTable" HBox.hgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="defectCreatedAtColumn" text="Datum a čas" prefWidth="180.0"/>
                        <TableColumn fx:id="defectTypeColumn" text="Typ defektu" prefWidth="150.0"/>
                        <TableColumn fx:id="defectCameraColumn" text="Kamera" prefWidth="110.0"/>
                        <TableColumn fx:id="defectBobinaColumn" text="Číslo bobiny"/>
                        <TableColumn fx:id="defectPositionColumn" text="Pozice v návinu" prefWidth="130.0"/>
                        <TableColumn fx:id="defectAreaColumn" text="Plocha defektu" prefWidth="110.0"/>
                        <TableColumn fx:id="defectSizeClassColumn" text="Velikost defektu" prefWidth="70.0"/>
                        <TableColumn fx:id="defectRejectColumn" text="Vyřazeno"/>
                        <TableColumn fx:id="defectLocationColumn" text="Poloha defektu" prefWidth="160.0"/>
                        <TableColumn fx:id="defectClassificationColumn" text="Klasifikace" prefWidth="150.0"/>
                    </columns>
                </TableView>

                <VBox spacing="8.0" prefWidth="440.0" minWidth="380.0">
                    <Label text="Snímek vybraného defektu"
                           style="-fx-font-size: 13px; -fx-font-weight: bold;"/>

                    <BorderPane style="-fx-background-color: #F7F7F7; -fx-border-color: #D0D0D0; -fx-border-radius: 6; -fx-background-radius: 6;">
                        <center>
                            <ImageView fx:id="defectPreviewImageView"
                                       fitWidth="410.0"
                                       fitHeight="270.0"
                                       preserveRatio="true"
                                       visible="false"
                                       managed="false"/>
                        </center>
                        <bottom>
                            <Label fx:id="defectPreviewPlaceholderLabel"
                                   text="Vyber defekt se snímkem."
                                   wrapText="true"
                                   style="-fx-text-fill: #666666; -fx-padding: 8 10 8 10;"/>
                        </bottom>
                    </BorderPane>
                </VBox>
            </HBox>
        </VBox>
    </center>
</BorderPane>
