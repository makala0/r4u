<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="16.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cz.be.r4u.ui.HomeController">
    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
    </padding>

    <Label text="Hlavní obrazovka" style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
    <Label fx:id="welcomeLabel" text="Vítej!" style="-fx-font-size: 16px;"/>

    <Button text="Otevřít dashboard" onAction="#onOpenDashboardClick"/>
    <Button text="Odhlásit se" onAction="#onLogoutClick"/>
</VBox>